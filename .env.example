VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Mật khẩu để vào khu vực Cài đặt (quản lý môn học...) và khu vực
# chỉnh sửa Kiểm tra (ngân hàng câu hỏi, tạo đề). Đây chỉ là một lớp
# khóa phía trình duyệt (project chưa có backend auth thật) — đủ để
# chặn học sinh vô tình vào nhầm khu vực chỉnh sửa. Nếu không đặt,
# mật khẩu mặc định là "studyvault-admin".
VITE_ADMIN_PASSWORD=your-admin-password

# --- Giai đoạn 2: AI đọc tài liệu + tạo câu hỏi (Google Gemini) ---
# Lấy key miễn phí tại: https://aistudio.google.com/apikey
# CHỈ đặt biến này trên Vercel (Project Settings → Environment Variables),
# KHÔNG thêm vào .env.local nếu file đó có thể lộ ra ngoài, và tuyệt đối
# KHÔNG thêm tiền tố VITE_ — nếu thêm VITE_ thì key sẽ bị nhúng vào code
# chạy trên trình duyệt và bị lộ. Biến này chỉ được đọc trong
# /api/analyze-document.ts và /api/generate-questions.ts (chạy trên server).
GEMINI_API_KEY=
